# ==============================================================================
# Autonomous Research & Competitive Intelligence Agent - Environment Config
# Free-first developer configuration (Groq + Tavily)
# ==============================================================================

# LLM Provider Configuration (Groq is the free-first default)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional: OpenAI-compatible alternative (e.g. OpenAI, Ollama, OpenRouter)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Search Provider Configuration (Tavily free tier default: 1,000 requests/mo)
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# Execution Modes
# Set to 'true' for offline deterministic test runs with zero API keys required
MOCK_MODE=false

# Failure Injection Demo: 'none', 'timeout', 'http_500', 'empty_response'
DEMO_FAILURE_MODE=none

# Research Budgets & Safety Limits
MAX_AGENT_STEPS=15
MAX_TOOL_CALLS=25
MAX_RETRIES_PER_TOOL=2
MAX_RESEARCH_TIME_SECONDS=300
MAX_SOURCE_COUNT=15
MAX_FETCH_CONTENT_LENGTH=20000

# Outputs
OUTPUT_DIR=output
LOG_LEVEL=INFO
