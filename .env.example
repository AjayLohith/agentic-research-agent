# ==============================================================================
# Autonomous Research & Competitive Intelligence Agent - Environment Configuration
# ==============================================================================

# LLM Configuration (OpenAI or any OpenAI-compatible provider, e.g. Ollama, Groq, OpenRouter, vLLM)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Search Provider Configuration: 'duckduckgo' (free, no key needed), 'tavily', or 'mock'
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=

# Execution Mode: Set to 'true' for offline deterministic test runs without API keys
MOCK_MODE=false

# Failure Injection Demo: 'none', 'timeout', 'http_500', 'empty_response'
DEMO_FAILURE_MODE=none

# Agent Research Budget & Safety Boundaries
MAX_AGENT_STEPS=15
MAX_TOOL_CALLS=25
MAX_RETRIES_PER_TOOL=2
MAX_RESEARCH_TIME_SECONDS=300
MAX_SOURCE_COUNT=15
MAX_FETCH_CONTENT_LENGTH=20000

# Output Directories
OUTPUT_DIR=output
LOG_LEVEL=INFO
